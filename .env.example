# Static operator file. Copy once; do not edit ADDR / DATABASE_URL / PUBLIC_API_ORIGIN /
# MAIL_MODE to "switch" between daily and playground. scripts/start vs scripts/dev
# select the process. Both can run at the same time.
#
# Production bind (scripts/start). Loopback only — register is public.
# 27182 is uncommon (not 8080) so other local APIs do not steal the port.
ADDR=127.0.0.1:27182
DATABASE_URL=postgres://vynno:vynno@localhost:5433/vynno?sslmode=disable

# Playground (scripts/dev, scripts/seed, scripts/reset). Not daily history.
DEV_ADDR=127.0.0.1:8081
DEV_DATABASE_URL=postgres://vynno:vynno@localhost:5433/vynno_dev?sslmode=disable

# Playground accounts only (cmd/devdata). The API process does not read these
# and does not create users — register from the SPA on production.
# BOOTSTRAP_USERNAME is still accepted: alexdev → alexdev@vynno.local.
BOOTSTRAP_EMAIL=alexdev@vynno.local
BOOTSTRAP_PASSWORD=local-dev-password

# Password for the extra demo accounts created by scripts/seed (maya, rio).
# Optional; defaults to local-dev-password.
# SEED_PASSWORD=local-dev-password

# Comma-separated SPA origins allowed for CORS + cookie CSRF checks.
SPA_ORIGIN=http://localhost:5173,http://localhost:4173,http://vynno.local

# Public origin of this API (no path). Used to compose ProfileDto.avatarUrl
# and as the origin for operator Swagger UI (open {PUBLIC_API_ORIGIN}/swagger/).
# Bookmark http://vynno.local:27182 — not localhost or 127.0.0.1; cookies are
# origin-exact. Requires /etc/hosts: 127.0.0.1 vynno.local (IPv4 only).
PUBLIC_API_ORIGIN=http://vynno.local:27182

# Set true behind HTTPS so the session cookie is Secure.
# Loopback HTTP (this machine) stays false.
COOKIE_SECURE=false

# Request logs: text (default, scripts/dev) or json (scripts/start).
LOG_FORMAT=text

# Outbound mail ([ADR-0015](./docs/adr/0015-outbound-email.md)).
# smtp = real send (daily driver, scripts/start). log = print body including codes.
# discard = tests (and the Load() default when MAIL_MODE is unset).
# smtp requires SMTP_HOST and MAIL_FROM; smtp must not log one-time codes.
# scripts/dev forces MAIL_MODE=log unless DEV_MAIL_MODE is set. Do not change this
# line to switch modes.
MAIL_MODE=smtp
# DEV_MAIL_MODE=log
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=vynno@localhost
MAIL_FROM_NAME=Vynno
#
# Local catcher is Mailpit in Compose (SMTP 1025, UI http://127.0.0.1:8025).
# First register and password reset need reachable SMTP (Mailpit or a real host).
# smtp mode must not log one-time codes; log mode prints the body (playground only).
