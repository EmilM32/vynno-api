# Production bind (scripts/start). Loopback only — register is public.
ADDR=127.0.0.1:8080
DATABASE_URL=postgres://vynno:vynno@localhost:5433/vynno?sslmode=disable

# Playground (scripts/dev, scripts/seed, scripts/reset). Not daily history.
DEV_ADDR=127.0.0.1:8081
DEV_DATABASE_URL=postgres://vynno:vynno@localhost:5433/vynno_dev?sslmode=disable

# Playground accounts only (cmd/devdata). The API process does not read these
# and does not create users — register from the SPA on production.
# BOOTSTRAP_USERNAME is still accepted: alexdev → alexdev@vynno.local.
BOOTSTRAP_EMAIL=alexdev@vynno.local
BOOTSTRAP_PASSWORD=local-dev-password

# Password for the extra demo accounts created by scripts/seed (maya, rio).
# Optional; defaults to local-dev-password.
# SEED_PASSWORD=local-dev-password

# Comma-separated SPA origins allowed for CORS + cookie CSRF checks.
SPA_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Public origin of this API (no path). Used to compose ProfileDto.avatarUrl
# and as the origin for operator Swagger UI (open {PUBLIC_API_ORIGIN}/swagger/).
# localhost and 127.0.0.1 are different origins — cookie Try-it-out must match.
PUBLIC_API_ORIGIN=http://localhost:8080

# Set true behind HTTPS so the session cookie is Secure.
# Loopback HTTP (this machine) stays false.
COOKIE_SECURE=false

# Request logs: text (default, scripts/dev) or json (scripts/start).
LOG_FORMAT=text
