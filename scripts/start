#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat <<'EOF'
Start Postgres (Docker Compose) and the API binary. Does not build.

  scripts/start           run in the foreground
  scripts/start --detach  background; pid in var/api.pid, logs in logs/api.log

Run scripts/build first when the binary is missing or stale.
EOF
}

DETACH=0
for arg in "$@"; do
	case "$arg" in
	--detach | -d) DETACH=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown argument: $arg"
		;;
	esac
done

load_env
require_var DATABASE_URL
require_prod_database
require_build

if pid="$(api_pid)"; then
	if [[ "$DETACH" -eq 1 ]]; then
		echo "already running pid $pid"
		exit 0
	fi
	die "already running (pid $pid); scripts/stop first"
fi

ensure_postgres

export GIN_MODE=release
export LOG_FORMAT=json

cd "$ROOT"

if [[ "$DETACH" -eq 1 ]]; then
	mkdir -p "$ROOT/logs" "$ROOT/var"
	nohup "$ROOT/bin/vynno-api" >>"$ROOT/logs/api.log" 2>&1 &
	pid=$!
	echo "$pid" >"$PIDFILE"
	wait_for_healthz "$(prod_listen_port)" "$pid"
	echo "started pid $pid  log $ROOT/logs/api.log"
	exit 0
fi

exec "$ROOT/bin/vynno-api"
