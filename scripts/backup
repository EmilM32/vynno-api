#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

ensure_postgres
mkdir -p "$ROOT/backups"
out="$ROOT/backups/vynno-$(date +%Y%m%d-%H%M%S).sql"
"${COMPOSE[@]}" exec -T postgres pg_dump -U vynno --no-owner --no-acl vynno >"$out"
echo "$out"
