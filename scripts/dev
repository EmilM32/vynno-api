#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat <<'EOF'
Run the API with go run against vynno_dev (does not use the release binary).

  scripts/dev

Listens on DEV_ADDR (default 127.0.0.1:8081). Foreground; Ctrl-C stops it.
Leftover after a closed terminal: scripts/stop --dev.
Does not touch database vynno or the production process on :27182.
Does not edit .env; remaps ADDR, DATABASE_URL, PUBLIC_API_ORIGIN, MAIL_MODE (smtp → Mailpit), COOKIE_SECURE.
OTP codes land in Mailpit (http://127.0.0.1:8025). DEV_MAIL_MODE=log prints them to the process instead.
EOF
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown argument: $arg"
		;;
	esac
done

load_env
require_dev_database_url

if pid="$(dev_api_pid)"; then
	die "already running (pid $pid); scripts/stop --dev first"
fi

ensure_postgres

export DATABASE_URL="$DEV_DATABASE_URL"
export ADDR="$(dev_addr)"
# Same-origin Swagger Try-it-out (CSRF + CORS) must match this process, not production :27182.
export PUBLIC_API_ORIGIN="http://${ADDR}"
# Playground default is smtp (Mailpit). DEV_MAIL_MODE=log prints OTPs to the process. Daily scripts/start keeps MAIL_MODE from .env.
export MAIL_MODE="${DEV_MAIL_MODE:-smtp}"
# Production .env has COOKIE_SECURE=true (HTTPS SPA). Vite and preview are HTTP.
export COOKIE_SECURE=false
unset GIN_MODE || true

cd "$ROOT"
mkdir -p "$ROOT/var"

cleanup_dev() {
	trap - EXIT INT TERM HUP
	stop_dev_api
}
trap cleanup_dev EXIT INT TERM HUP

go run ./cmd/api &
dev_run_pid=$!
echo "$dev_run_pid" >"$DEV_PIDFILE"

set +e
wait "$dev_run_pid"
status=$?
set -e
exit "$status"
