#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat <<'EOF'
Wipe vynno_dev application tables and load the demo playground (three users + history).
Does not touch database vynno or the production API.

  scripts/seed
  scripts/seed --yes

Logins (passwords printed by the command):
  alexdev   BOOTSTRAP_PASSWORD from .env
  maya      SEED_PASSWORD (default local-dev-password)
  rio       same as maya

Stop scripts/dev first if it is running against vynno_dev.
EOF
}

YES=0
for arg in "$@"; do
	case "$arg" in
	--yes | -y) YES=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown argument: $arg"
		;;
	esac
done

load_env
require_dev_database_url

if [[ "$YES" -ne 1 && -t 0 ]]; then
	printf 'Wipe database vynno_dev and load the demo dataset? [y/N] '
	read -r ans
	case "$ans" in
	y | Y | yes | YES) ;;
	*) die "aborted" ;;
	esac
fi

ensure_postgres
export DATABASE_URL="$DEV_DATABASE_URL"
(
	cd "$ROOT"
	go run ./cmd/devdata seed
)
echo "playground is vynno_dev; start it with scripts/dev"
