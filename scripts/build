#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

mkdir -p "$ROOT/bin"
(cd "$ROOT" && go build -o bin/vynno-api ./cmd/api)
(cd "$ROOT" && go build -o bin/vynno-mcp ./cmd/mcp)
echo "$ROOT/bin/vynno-api"
echo "$ROOT/bin/vynno-mcp"
