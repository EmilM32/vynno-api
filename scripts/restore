#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat <<'EOF'
Replace the vynno database from a pg_dump file. Stops the API first.

  scripts/restore backups/vynno-YYYYMMDD-HHMMSS.sql
  scripts/restore --yes backups/vynno-YYYYMMDD-HHMMSS.sql
EOF
}

YES=0
FILE=""
for arg in "$@"; do
	case "$arg" in
	--yes | -y) YES=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		if [[ -n "$FILE" ]]; then
			die "unexpected argument: $arg"
		fi
		FILE="$arg"
		;;
	esac
done

[[ -n "$FILE" ]] || die "usage: scripts/restore [--yes] <dump.sql>"
[[ -f "$FILE" ]] || die "not a file: $FILE"

if [[ "$YES" -ne 1 && -t 0 ]]; then
	printf 'Replace database vynno from %s? [y/N] ' "$FILE"
	read -r ans
	case "$ans" in
	y | Y | yes | YES) ;;
	*) die "aborted" ;;
	esac
fi

stop_api
ensure_postgres

"${COMPOSE[@]}" exec -T postgres psql -U vynno -d postgres -v ON_ERROR_STOP=1 <<'SQL'
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = 'vynno' AND pid <> pg_backend_pid();
DROP DATABASE IF EXISTS vynno;
CREATE DATABASE vynno OWNER vynno;
SQL

"${COMPOSE[@]}" exec -T postgres psql -U vynno -d vynno -v ON_ERROR_STOP=1 <"$FILE"
echo "restored $FILE"
